generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id              Int     @id @default(autoincrement())
  key             String  @unique
  label           String
  canManageUsers  Boolean @default(false)
  canManageSettings Boolean @default(false)
  canManagePosts  Boolean @default(false)
  canManageGallery Boolean @default(false)
  canManageMemberProfiles Boolean @default(false)

  users           User[]
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  nickname          String?
  whatsapp          String?
  username          String    @unique
  email             String    @unique
  passwordHash      String
  avatarUrl         String?
  caricatureUrl     String?
  birthDate         DateTime? @db.Date
  isPontaFirme      Boolean   @default(false)
  roleId            Int
  role              Role      @relation(fields: [roleId], references: [id])
  mustChangePassword Boolean  @default(true)
  createdAt         DateTime  @default(now())

  posts             Post[]
  likes             Like[]
  comments          Comment[]
  announcements     Announcement[]
  announcementViews AnnouncementView[]
}

model SiteSettings {
  id           Int      @id @default(autoincrement())
  siteName     String   @default("Amigos Fura-Bucho")
  subtitle     String?
  foundingYear Int?
  logoUrl      String?
  heroTitle    String?
  heroImageUrl String?
  aboutText    String?  @db.Text
  updatedAt    DateTime @updatedAt
}

model Banner {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  title     String?
  subtitle  String?
  linkUrl   String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  bannerUrl   String?
  eventDate   DateTime
  location    String?
  createdAt   DateTime @default(now())
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  imageUrl    String
  link        String?
  active      Boolean  @default(true)
  scheduledAt DateTime @default(now())
  createdAt   DateTime @default(now())
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  views       AnnouncementView[]
}

model AnnouncementView {
  id             Int          @id @default(autoincrement())
  announcementId Int
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt       DateTime     @default(now())

  @@unique([announcementId, userId])
}

model Post {
  id        Int       @id @default(autoincrement())
  authorId  Int
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mediaType String    @default("image")
  imageUrl  String?
  caption   String?   @db.Text
  blocked   Boolean   @default(false)
  createdAt DateTime  @default(now())

  likes     Like[]
  comments  Comment[]
}

model Like {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  text      String   @db.Text
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Gallery {
  id        Int      @id @default(autoincrement())
  title     String
  year      Int
  createdAt DateTime @default(now())

  images    GalleryImage[]
}

model GalleryImage {
  id        Int      @id @default(autoincrement())
  galleryId Int
  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  imageUrl  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
