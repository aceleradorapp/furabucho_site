generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  label       String

  users       User[]
  permissions RolePermission[]
}

model RolePermission {
  id     Int     @id @default(autoincrement())
  roleId Int
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  key    String
  value  Boolean @default(false)

  @@unique([roleId, key])
}

model UserPermissionOverride {
  id     Int     @id @default(autoincrement())
  userId Int
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  value  Boolean

  @@unique([userId, key])
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  nickname          String?
  whatsapp          String?   @unique
  username          String    @unique
  email             String?   @unique
  passwordHash      String
  avatarUrl         String?
  caricatureUrl     String?
  birthDate         DateTime? @db.Date
  isPontaFirme      Boolean   @default(false)
  isVeterano        Boolean   @default(false)
  roleId            Int
  role              Role      @relation(fields: [roleId], references: [id])
  mustChangePassword Boolean  @default(true)
  createdAt         DateTime  @default(now())

  posts             Post[]
  likes             Like[]
  comments          Comment[]
  announcements     Announcement[]
  announcementViews AnnouncementView[]
  permissionOverrides UserPermissionOverride[]
  pontaFirmePayers  PontaFirmePayer[]
  pontaFirmeEventPayers PontaFirmeEventPayer[]
  convertedFromPioneiro Pioneiro?
}

model SiteSettings {
  id                       Int      @id @default(autoincrement())
  siteName                 String   @default("Amigos Fura-Bucho")
  subtitle                 String?
  foundingYear             Int?
  logoUrl                  String?
  heroTitle                String?
  heroImageUrl             String?
  aboutText                String?  @db.Text
  pioneirosCampaignActive  Boolean  @default(true)
  updatedAt                DateTime @updatedAt
}

model Pioneiro {
  id              Int      @id @default(autoincrement())
  name            String
  email           String?  @unique
  phone           String?  @unique
  passwordHash    String
  avatarUrl       String?
  points          Float    @default(0)
  status          String   @default("pending")
  convertedUserId Int?     @unique
  convertedUser   User?    @relation(fields: [convertedUserId], references: [id])
  lastVisitAt     DateTime?
  createdAt       DateTime @default(now())

  photos          PioneiroPhoto[]
  comments        PioneiroComment[]
}

model PioneiroPhoto {
  id         Int       @id @default(autoincrement())
  pioneiroId Int
  pioneiro   Pioneiro  @relation(fields: [pioneiroId], references: [id], onDelete: Cascade)
  title      String
  imageUrl   String
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
}

model PioneiroComment {
  id         Int      @id @default(autoincrement())
  pioneiroId Int
  pioneiro   Pioneiro @relation(fields: [pioneiroId], references: [id], onDelete: Cascade)
  text       String   @db.Text
  createdAt  DateTime @default(now())
}

model Banner {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  title     String?
  subtitle  String?
  linkUrl   String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  bannerUrl   String?
  eventDate   DateTime
  location    String?
  createdAt   DateTime @default(now())
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  imageUrl    String
  link        String?
  active      Boolean  @default(true)
  scheduledAt DateTime @default(now())
  createdAt   DateTime @default(now())
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  views       AnnouncementView[]
}

model AnnouncementView {
  id             Int          @id @default(autoincrement())
  announcementId Int
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt       DateTime     @default(now())

  @@unique([announcementId, userId])
}

model Post {
  id        Int       @id @default(autoincrement())
  authorId  Int
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mediaType String    @default("image")
  imageUrl  String?
  caption   String?   @db.Text
  blocked   Boolean   @default(false)
  createdAt DateTime  @default(now())

  likes     Like[]
  comments  Comment[]
}

model Like {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  text      String   @db.Text
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Gallery {
  id        Int      @id @default(autoincrement())
  title     String
  year      Int
  createdAt DateTime @default(now())

  images    GalleryImage[]
}

model GalleryImage {
  id            Int      @id @default(autoincrement())
  galleryId     Int
  gallery       Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  imageUrl      String
  active        Boolean  @default(true)
  featured      Boolean  @default(false)
  featuredOrder Int?
  createdAt     DateTime @default(now())
}

model PontaFirmeSeason {
  id        Int      @id @default(autoincrement())
  label     String   @unique
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())

  payers       PontaFirmePayer[]
  expenseCards PontaFirmeExpenseCard[]
  eventPayers  PontaFirmeEventPayer[]
}

model PontaFirmePayer {
  id          Int              @id @default(autoincrement())
  seasonId    Int
  season      PontaFirmeSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId      Int?
  user        User?            @relation(fields: [userId], references: [id])
  displayName String?
  removedAt   DateTime?
  createdAt   DateTime         @default(now())

  payments PontaFirmePayment[]

  @@unique([seasonId, userId])
}

model PontaFirmePayment {
  id        Int             @id @default(autoincrement())
  payerId   Int
  payer     PontaFirmePayer @relation(fields: [payerId], references: [id], onDelete: Cascade)
  monthDate DateTime        @db.Date
  amount    Decimal         @db.Decimal(10, 2)
  paidAt    DateTime
  createdAt DateTime        @default(now())

  @@unique([payerId, monthDate])
}

model PontaFirmeExpenseCard {
  id        Int              @id @default(autoincrement())
  seasonId  Int
  season    PontaFirmeSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  title     String
  order     Int              @default(0)
  createdAt DateTime         @default(now())

  items PontaFirmeExpenseItem[]
}

model PontaFirmeExpenseItem {
  id        Int                   @id @default(autoincrement())
  cardId    Int
  card      PontaFirmeExpenseCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label     String
  amount    Decimal               @db.Decimal(10, 2)
  createdAt DateTime              @default(now())
}

model PontaFirmeEventPayer {
  id             Int              @id @default(autoincrement())
  seasonId       Int
  season         PontaFirmeSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId         Int?
  user           User?            @relation(fields: [userId], references: [id])
  displayName    String?
  valuePerPerson Decimal          @db.Decimal(10, 2)
  paymentType    String           @default("inteiro")
  createdAt      DateTime         @default(now())

  guests PontaFirmeEventGuest[]

  @@unique([seasonId, userId])
}

model PontaFirmeEventGuest {
  id          Int                  @id @default(autoincrement())
  payerId     Int
  payer       PontaFirmeEventPayer @relation(fields: [payerId], references: [id], onDelete: Cascade)
  name        String
  paymentType String               @default("inteiro")
  createdAt   DateTime             @default(now())
}
